@model IEnumerable<sistema_web_de_rutas.Models.Repartidor>

@{
    ViewData["Title"] = "Repartidores";
}

<h1>Repartidores</h1>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

<p>
    <a asp-action="Crear" class="btn btn-primary">
        Registrar repartidor
    </a>
</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Usuario</th>
                <th>Capacidad de carga</th>
                <th>Disponible para nuevas rutas</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var repartidor in Model)
            {
                <tr>
                    <td>@repartidor.Nombre</td>
                    <td>@repartidor.Usuario.UserName</td>
                    <td>@repartidor.CapacidadCarga</td>
                    <td>@(repartidor.Disponible ? "Sí" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
</div>