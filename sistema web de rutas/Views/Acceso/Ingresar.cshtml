@model sistema_web_de_rutas.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Iniciar sesión</h1>
        <p>Panadería Familiar Matorra</p>

        <form asp-controller="Acceso"
              asp-action="Ingresar"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger"></div>

            <input asp-for="ReturnUrl" type="hidden" />

            <div class="mb-3">
                <label asp-for="Usuario" class="form-label"></label>
                <input asp-for="Usuario"
                       class="form-control"
                       autocomplete="username" />
            </div>

            <div class="mb-3">
                <label asp-for="Clave" class="form-label">
                    Contraseña
                </label>
                <input asp-for="Clave"
                       type="password"
                       class="form-control"
                       autocomplete="current-password" />
            </div>

            <button class="btn btn-primary" type="submit">
                Ingresar
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}