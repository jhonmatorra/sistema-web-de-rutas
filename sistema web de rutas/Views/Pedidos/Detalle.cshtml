@model sistema_web_de_rutas.Models.Pedido

@{
    ViewData["Title"] = "Detalle del pedido";
}

<h1>Pedido #@Model.Id</h1>

<p><strong>Cliente:</strong> @Model.Cliente.Nombre</p>
<p><strong>Dirección:</strong> @Model.Cliente.Direccion</p>
<p><strong>Estado:</strong> @Model.Estado</p>
<p><strong>Pago:</strong> @Model.EstadoPago — @Model.MetodoPago</p>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario Bs</th>
            <th>Subtotal Bs</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detalle in Model.Detalles)
        {
            <tr>
                <td>@detalle.Producto.Nombre</td>
                <td>@detalle.Cantidad</td>
                <td>@detalle.PrecioUnitario.ToString("0.00")</td>
                <td>@detalle.Subtotal.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<h2>Total: Bs @Model.Total.ToString("0.00")</h2>

<p><strong>Observaciones:</strong> @Model.Observaciones</p>

<a asp-action="Index" class="btn btn-secondary">Volver a pedidos</a>